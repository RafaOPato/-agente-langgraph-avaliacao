# Todas opcionais. Os scripts Python NÃO leem este arquivo: exporte as variáveis no shell.

# Desliga a telemetria do DeepEval (os scripts do repositório já fazem isso, mas vale para quem rodar à mão).
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# Se as duas chaves do Langfuse estiverem definidas, o grafo manda os traces para ele.
# Sem elas, o rastreamento fica desligado e nada muda no resultado.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Servidor próprio (self-hosted) ou nuvem. Sem valor, o SDK usa o padrão dele.
LANGFUSE_HOST=
